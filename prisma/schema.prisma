// Visit Taita — data model (Phase 2: users/auth, content, Passport. Phase 3: Taita Cup sports portal)
// Run `npx prisma migrate dev` after setting DATABASE_URL, then `npm run db:seed`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / users
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CONTENT_MANAGER
  PARTNER
  SELLER
  EVENT_MANAGER
  CREATOR
  MEMBER
  VISITOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VISITOR)
  // When the person accepted the Terms and acknowledged the Privacy Policy, and which version of them.
  termsAcceptedAt DateTime?
  termsVersion    String?
  // Set when they click the link we emailed to this address (or complete a password reset, which proves the same thing).
  emailVerifiedAt DateTime?
  // Set when the password is reset. Any sign-in older than this is ended (see lib/auth.ts).
  passwordChangedAt DateTime?
  // Set by an administrator. A suspended account can't sign in and any sign-in it has is ended (see lib/auth.ts).
  suspendedAt     DateTime?
  suspendedReason String?
  // Set when an administrator invited this person. "Invite pending" means: invited, and hasn't yet chosen a password.
  invitedAt DateTime?
  // "Sign out everywhere": any sign-in older than this is ended.
  sessionsRevokedAt DateTime?
  accountTokens     AccountToken[]
  auditActions      AdminAuditLog[] @relation("AuditActor")
  uploads           UploadedImage[]
  points       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  visits      Visit[]
  badges      UserBadge[]
  storiesWritten     Story[]       @relation("StoryAuthor")
  destinationsAdded  Destination[] @relation("DestinationCreatedBy")
  productsSold       Product[]     @relation("ProductsSold")
  ordersPlaced       Order[]       @relation("OrdersPlaced")
  applicationsReviewed PartnerApplication[] @relation("ApplicationsReviewed")
  pointsEntries        PointsEntry[]
  redemptions          RewardRedemption[]
  rewardsOwned         Reward[]           @relation("RewardPartner")
  reviews              Review[]
  creatorApplications  CreatorApplication[]
  creator              Creator?

  accommodationsOwned    Accommodation[]        @relation("AccommodationOwner")
  experiencesOwned       Experience[]           @relation("ExperienceOwner")
  accommodationEnquiries AccommodationEnquiry[] @relation("AccommodationEnquiriesMade")
  experienceEnquiries    ExperienceEnquiry[]    @relation("ExperienceEnquiriesMade")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Content — Discover / destinations
// ---------------------------------------------------------------------------

enum DiscoverCategory {
  WILD
  CULTURE
  ADVENTURE
  FOOD
  SPORT
  PEOPLE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model Destination {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  category  DiscoverCategory
  region    String
  blurb     String
  image     String
  latitude  Float?
  longitude Float?
  status    ContentStatus    @default(DRAFT)
  featured  Boolean          @default(false)
  isDemo    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  createdById String?
  createdBy   User?   @relation("DestinationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Passport check-ins: a secret printed in the plaque's QR code (rotate to
  // invalidate a leaked one) and how close, in metres, a GPS check-in must be.
  checkinToken   String? @unique
  checkinRadiusM Int     @default(300)

  visits   Visit[]
  missions Mission[]

  @@index([category, status])
}

// ---------------------------------------------------------------------------
// Content — Stories (editorial)
// ---------------------------------------------------------------------------

enum StoryCategory {
  PEOPLE
  PLACES
  CULTURE
  SPORT
  ADVENTURE
}

model Story {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  category    StoryCategory
  excerpt     String
  body        String        @default("")
  readingTime String
  image       String
  status      ContentStatus @default(DRAFT)
  featured    Boolean       @default(false)
  isDemo      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  authorId String?
  author   User?   @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([category, status])
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

enum EventProgram {
  TAITA_CUP
  TAITA_WEEK
  TAITA_SOUND
}

model Event {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  program   EventProgram
  eventDate DateTime
  location  String
  blurb     String
  status    ContentStatus @default(DRAFT)
  isDemo    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([program, eventDate])
}

// ---------------------------------------------------------------------------
// Taita Passport — badges, points, visits
// ---------------------------------------------------------------------------

model Badge {
  id          String @id @default(cuid())
  key         String @unique // e.g. TAITA_WILD, TAITA_EXPLORER
  label       String
  description String
  icon        String @default("🧭")

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Visit {
  id            String   @id @default(cuid())
  userId        String
  destinationId String
  visitedAt     DateTime @default(now())
  method        VisitMethod @default(SELF_REPORTED)
  // The last time this person passed a QR/GPS check-in here (refreshed on repeats; visitedAt stays the first).
  lastVerifiedAt DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}

// ---------------------------------------------------------------------------
// Newsletter
// ---------------------------------------------------------------------------

// A person only receives the newsletter after CONFIRMING their address (double opt-in): a new signup is PENDING until they
// click the link we email them. Rows that existed before this (ACTIVE, with no confirmedAt) are "legacy": they are not mailed
// until they confirm. Unsubscribing keeps the row as a do-not-email record (deleting an account removes it).
// A picture someone uploaded. We keep a record so unused files can be cleaned up, a person's pictures can be deleted with their
// account and listed in their data export, and uploads can be rate-limited. The file itself lives in object storage.
model UploadedImage {
  id         String   @id @default(cuid())
  key        String   @unique // where it is in storage
  url        String   @unique // the public address it is served from
  purpose    String // photo | product | logo | avatar | note
  bytes      Int
  width      Int
  height     Int
  createdAt  DateTime @default(now())
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([uploaderId])
}

// A short, permanent address on our own domain (/go/<slug>) that a printed QR code points at. The destination can be changed
// later without reprinting; a link can be switched off but never deleted or renamed, because printed copies exist.
model ShortLink {
  id            String         @id @default(cuid())
  slug          String         @unique
  label         String
  target        String // a page on this site (starting with /) or a full https:// address
  active        Boolean        @default(true)
  clicks        Int            @default(0)
  lastClickedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  days          ShortLinkDay[]
}

// Scans per day (East Africa Time). No IP address, device or person is recorded — only a count.
model ShortLinkDay {
  id     String    @id @default(cuid())
  linkId String
  link   ShortLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  day    DateTime  @db.Date
  count  Int       @default(0)

  @@unique([linkId, day])
  @@index([day])
}

// Who changed which account, and when: creating, inviting, changing a role, suspending, sending reset links. The email addresses
// are copied in (a snapshot) so the record still makes sense after an account is deleted — and the target's address is blanked
// when THEIR account is deleted.
model AdminAuditLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail   String
  action       String // user.invite | user.role | user.suspend | user.reinstate | user.signout | user.reset_link | user.verify_link
  targetUserId String?
  targetEmail  String?
  detail       String?

  @@index([createdAt])
  @@index([targetUserId, createdAt])
}

enum AccountTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// A single-use, expiring link we email: "verify this address" or "reset this password". Only a SHA-256 HASH of the secret is
// stored, so a copy of the database can't be used to verify an address or take over an account.
model AccountToken {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AccountTokenPurpose
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  createdAt      DateTime         @default(now())
  status         SubscriberStatus @default(ACTIVE) // existing rows stay ACTIVE (legacy, unconfirmed)
  token          String?          @unique // secret in the confirm and unsubscribe links
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  @@index([status])
}

// One newsletter. A draft can be edited; sending turns it into one outbox row per confirmed subscriber (EmailLog.campaignId),
// so delivery, retries and progress all come from the email outbox. startedAt is null while it is still a draft.
model NewsletterCampaign {
  id             String    @id @default(cuid())
  subject        String
  body           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  recipientCount Int       @default(0)
  createdById    String?
}

// ---------------------------------------------------------------------------
// Taita Cup — sports portal (teams, fixtures, standings)
// ---------------------------------------------------------------------------

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

model SportVenue {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  location  String
  capacity  Int?
  image     String
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fixtures SportFixture[]

  @@index([slug])
}

model SportTeam {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  town      String
  crest     String
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players      SportPlayer[]
  homeFixtures SportFixture[] @relation("HomeTeam")
  awayFixtures SportFixture[] @relation("AwayTeam")

  @@index([slug])
}

model SportPlayer {
  id        String   @id @default(cuid())
  name      String
  position  String
  number    Int?
  photo     String?
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId String
  team   SportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model SportFixture {
  id        String        @id @default(cuid())
  kickoff   DateTime
  status    FixtureStatus @default(SCHEDULED)
  homeScore Int?
  awayScore Int?
  round     String?
  isDemo    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  homeTeamId String
  awayTeamId String
  venueId    String

  homeTeam SportTeam  @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam SportTeam  @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  venue    SportVenue @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([status, kickoff])
}

// ---------------------------------------------------------------------------
// Taita Made — marketplace (products, orders)
// ---------------------------------------------------------------------------

enum ProductCategory {
  CLOTHING
  ART
  CRAFTS
  FOOD
  HOME
  BOOKS
  PHOTOGRAPHY
  COLLECTIBLES
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum FulfillmentMethod {
  SHIPPING
  LOCAL_PICKUP
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  price       Int // whole KES, no decimals
  image       String
  category    ProductCategory
  sku         String          @unique
  inventory   Int             @default(0)
  // What a buyer must choose before adding it to the cart — normally SIZES (["S","M","L","XL"]). Empty = nothing to choose.
  // Stock is shared across the options (it is not tracked per size).
  options     String[]        @default([])
  optionLabel String          @default("Size")
  offersShipping   Boolean    @default(true)
  offersPickup     Boolean    @default(true)
  status      ContentStatus   @default(DRAFT)
  featured    Boolean         @default(false)
  isDemo      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  sellerId String?
  seller   User?   @relation("ProductsSold", fields: [sellerId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@index([category, status])
}

enum PaymentMethod {
  NONE
  MPESA
  CARD
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

model Order {
  id          String            @id @default(cuid())
  orderNumber String            @unique
  status      OrderStatus       @default(PENDING)
  fulfillment FulfillmentMethod
  address     String?
  phone       String
  totalAmount Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  paymentMethod PaymentMethod @default(NONE)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentFailureReason String?
  paidAt        DateTime?

  mpesaCheckoutRequestId String?
  mpesaMerchantRequestId String?
  mpesaReceiptNumber     String?

  pesapalOrderTrackingId String?
  pesapalMerchantReference String?
  pesapalConfirmationCode  String?

  // Optional + SetNull: if the buyer deletes their account the order is kept (anonymised) for the payment record.
  buyerId String?
  buyer   User?  @relation("OrdersPlaced", fields: [buyerId], references: [id], onDelete: SetNull)

  items OrderItem[]

  @@index([buyerId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id        String @id @default(cuid())
  quantity  Int
  unitPrice Int // snapshot of Product.price at order time
  option    String? // the size (or other choice) the buyer picked, as it was at order time

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Partner portal — applications
// ---------------------------------------------------------------------------

enum PartnerType {
  ACCOMMODATION
  EXPERIENCE
  FOOD
  TRANSPORT
  CREATOR
  SELLER
  EVENT
  SPONSOR
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PartnerApplication {
  id          String                    @id @default(cuid())
  businessName String
  contactName String
  email       String
  phone       String
  website     String?
  partnerType PartnerType
  message     String
  status      PartnerApplicationStatus  @default(PENDING)
  adminNotes  String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  reviewedAt  DateTime?

  reviewedById String?
  reviewedBy   User?   @relation("ApplicationsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Taita Week — festival programme
// ---------------------------------------------------------------------------

enum SessionCategory {
  MUSIC
  FOOD
  CULTURE
  SPORT
  FAMILY
  MARKET
  TALKS
}

enum TicketStatus {
  FREE
  TICKETED
  SOLD_OUT
}

model FestivalVenue {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  location  String
  image     String
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions FestivalSession[]

  @@index([slug])
}

model FestivalSession {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  category     SessionCategory
  description  String
  startsAt     DateTime
  endsAt       DateTime?
  ticketStatus TicketStatus    @default(FREE)
  price        Int?
  ticketUrl    String?
  status       ContentStatus   @default(DRAFT)
  featured     Boolean         @default(false)
  isDemo       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  venueId String
  venue   FestivalVenue @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([status, startsAt])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Experiences & Accommodation — enquiry-based bookings
// ---------------------------------------------------------------------------
// Deliberately NOT a real-time booking/payment engine (no availability
// calendar, no online payment capture) — matches the brief's Phase-3 scope:
// listings + an enquiry form, with an optional external booking link for
// partners who already run their own reservations system. Tied into the
// existing PartnerType.ACCOMMODATION / PartnerType.EXPERIENCE application
// types and the SELLER-style ownership pattern already used by Taita Made.

enum AccommodationType {
  HOTEL
  LODGE
  GUESTHOUSE
  HOMESTAY
  CAMPSITE
}

enum ExperienceCategory {
  WILDLIFE
  CULTURE
  ADVENTURE
  FOOD
  WELLNESS
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONFIRMED
  DECLINED
}

model Accommodation {
  id                 String            @id @default(cuid())
  slug               String            @unique
  name               String
  type               AccommodationType
  region             String
  description        String
  image              String
  priceFrom          Int? // whole KES, per night — optional ("contact for rates")
  amenities          String[]          @default([])
  contactPhone       String?
  contactEmail       String?
  externalBookingUrl String? // optional link to the partner's own booking engine
  status             ContentStatus     @default(DRAFT)
  featured           Boolean           @default(false)
  isDemo             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  ownerId String?
  owner   User?   @relation("AccommodationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  enquiries          AccommodationEnquiry[]
  reviews            Review[]
  featuredByMissions Mission[]

  @@index([type, status])
  @@index([ownerId])
}

model AccommodationEnquiry {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  name            String
  email           String
  phone           String
  checkIn         DateTime?
  checkOut        DateTime?
  guests          Int?
  message         String
  status          EnquiryStatus @default(NEW)
  createdAt       DateTime      @default(now())

  userId String?
  user   User?   @relation("AccommodationEnquiriesMade", fields: [userId], references: [id], onDelete: SetNull)

  // Set only when the visitor reached this listing through a link on a mission or one of its Field Notes,
  // and the listing is the one that mission features. Never required, never affects the enquiry itself.
  referredByNoteId    String?
  referredByNote      FieldNote? @relation(fields: [referredByNoteId], references: [id], onDelete: SetNull)
  referredByMissionId String?
  referredByMission   Mission?   @relation(fields: [referredByMissionId], references: [id], onDelete: SetNull)

  // Who last changed the status, and when. "Confirmed" feeds sponsor reports and review verification, so this is kept.
  statusChangedAt   DateTime?
  statusChangedById String? // the user id of the host or admin; plain id (no relation), so deleting that user never touches the enquiry

  @@index([accommodationId, status])
  @@index([userId])
  @@index([referredByMissionId])
  @@index([referredByNoteId])
}

model Experience {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  category           ExperienceCategory
  region             String
  description        String
  image              String
  priceFrom          Int? // whole KES, per person — optional
  duration           String? // free text, e.g. "3 hours", "Full day"
  groupSizeMax       Int?
  contactPhone       String?
  contactEmail       String?
  externalBookingUrl String?
  status             ContentStatus      @default(DRAFT)
  featured           Boolean            @default(false)
  isDemo             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  ownerId String?
  owner   User?   @relation("ExperienceOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  enquiries          ExperienceEnquiry[]
  reviews            Review[]
  featuredByMissions Mission[]

  @@index([category, status])
  @@index([ownerId])
}

model ExperienceEnquiry {
  id            String        @id @default(cuid())
  experienceId  String
  experience    Experience    @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  name          String
  email         String
  phone         String
  preferredDate DateTime?
  partySize     Int?
  message       String
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())

  userId String?
  user   User?   @relation("ExperienceEnquiriesMade", fields: [userId], references: [id], onDelete: SetNull)

  // See AccommodationEnquiry.referredByNoteId.
  referredByNoteId    String?
  referredByNote      FieldNote? @relation(fields: [referredByNoteId], references: [id], onDelete: SetNull)
  referredByMissionId String?
  referredByMission   Mission?   @relation(fields: [referredByMissionId], references: [id], onDelete: SetNull)

  // Who last changed the status, and when. "Confirmed" feeds sponsor reports and review verification, so this is kept.
  statusChangedAt   DateTime?
  statusChangedById String? // the user id of the host or admin; plain id (no relation), so deleting that user never touches the enquiry

  @@index([experienceId, status])
  @@index([userId])
  @@index([referredByMissionId])
  @@index([referredByNoteId])
}

// ---------------------------------------------------------------------------
// Sponsorship — packages, sponsors, and inbound leads
// ---------------------------------------------------------------------------
// Packages mirror the rate card in the founding brief. Those figures are
// "illustrative starting points / negotiation anchors", so the public page
// presents them as indicative, never as fixed prices. Sponsors are real
// partners only — nothing is seeded, so the site never shows an invented
// sponsor.

enum SponsorLeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

model SponsorPackage {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  startingPrice Int // whole KES, indicative "from" figure
  priceNote     String? // e.g. "per year"
  rights        String[]      @default([]) // core rights, shown as a list
  sortOrder     Int           @default(0)
  status        ContentStatus @default(DRAFT)
  isDemo        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sponsors Sponsor[]
  leads    SponsorLead[]

  @@index([status, sortOrder])
}

model Sponsor {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  logo         String // image URL
  website      String?
  programs     EventProgram[] @default([]) // which event pages show this sponsor
  showOnHome   Boolean        @default(false)
  displayOrder Int            @default(0)
  status       ContentStatus  @default(DRAFT)
  isDemo       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  packageId String?
  package   SponsorPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  // The secret in the shareable impact-report link (rotate to invalidate; null = no link).
  reportToken String? @unique

  missions Mission[]

  @@index([status, displayOrder])
  @@index([packageId])
}

model SponsorLead {
  id          String            @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String
  website     String?
  budgetRange String?
  message     String
  status      SponsorLeadStatus @default(NEW)
  adminNotes  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  packageId String?
  package   SponsorPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([packageId])
}

// ---------------------------------------------------------------------------
// Passport — verified check-ins, points ledger, rewards
// ---------------------------------------------------------------------------
// Points are a LEDGER: User.points is a cached balance that must equal the sum
// of that user's PointsEntry rows. Only verified check-ins (QR / GPS) earn
// points; the old self-reported "mark visited" earns none, because points can
// now be spent on real rewards.

enum VisitMethod {
  SELF_REPORTED
  QR
  LOCATION
}

enum PointsReason {
  LEGACY // balance carried over from before the ledger existed
  CHECKIN
  MISSION
  REDEMPTION
  REFUND
  ADJUSTMENT
}

enum RedemptionStatus {
  ISSUED
  USED
  CANCELLED
}

model PointsEntry {
  id            String       @id @default(cuid())
  userId        String
  points        Int // positive = earned, negative = spent
  reason        PointsReason
  note          String?
  destinationId String? // set for CHECKIN entries
  redemptionId  String? // set for REDEMPTION / REFUND entries
  createdAt     DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One CHECKIN award per person per destination, enforced by the database,
  // so un-marking and re-marking a visit can never farm points.
  // (NULL destinationId rows — legacy, redemptions — never conflict.)
  @@unique([userId, destinationId, reason])
  @@index([userId, createdAt])
}

model Reward {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String
  pointsCost   Int
  image        String?
  partnerName  String? // who honours it, e.g. a lodge or sponsor
  instructions String // how the holder redeems the voucher
  stock        Int? // null = unlimited
  validUntil   DateTime?
  status       ContentStatus @default(DRAFT)
  isDemo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // The partner account that honours this reward. They can look up its vouchers and
  // mark them used from /partner/vouchers. Null = only Visit Taita staff can.
  ownerId String?
  owner   User?   @relation("RewardPartner", fields: [ownerId], references: [id], onDelete: SetNull)

  redemptions RewardRedemption[]

  @@index([status, pointsCost])
  @@index([ownerId])
}

model RewardRedemption {
  id          String           @id @default(cuid())
  code        String           @unique // short voucher code shown to the holder
  userId      String
  rewardId    String
  pointsSpent Int
  status      RedemptionStatus @default(ISSUED)
  createdAt   DateTime         @default(now())
  usedAt      DateTime?
  usedById    String? // user id of the partner or admin who marked it used

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([rewardId, status])
}

// ---------------------------------------------------------------------------
// Reviews — stays and experiences
// ---------------------------------------------------------------------------
// A review targets EXACTLY ONE of accommodation / experience (enforced in the
// server action; the two unique constraints below stop a person reviewing the
// same listing twice). Reviews are moderated: they are PENDING until an admin
// approves them, and an edited review goes back to PENDING. "verified" is a
// snapshot taken when the review was written: the author had a CONFIRMED
// enquiry for that listing.

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id              String       @id @default(cuid())
  userId          String
  accommodationId String?
  experienceId    String?
  rating          Int // 1-5, enforced in the server action
  title           String?
  body            String
  verified        Boolean      @default(false)
  status          ReviewStatus @default(PENDING)
  rejectionReason String?
  moderatedAt     DateTime?
  moderatedById   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accommodation Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  experience    Experience?    @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([userId, accommodationId])
  @@unique([userId, experienceId])
  @@index([accommodationId, status])
  @@index([experienceId, status])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Taita Field Crew — creators (Phase 1: applications + public profiles)
// ---------------------------------------------------------------------------
// A CreatorApplication is a request staff review; a Creator profile exists only
// once someone is approved (and then their account gets the CREATOR role).
// Two tracks: LOCAL_VOICE (community storytellers, no audience requirement) and
// VISITING_CREATOR. Follower numbers are self-reported and unverifiable, so they
// live only in an admin-only note and are never shown publicly. Links only —
// there is no file storage.

enum CreatorTrack {
  LOCAL_VOICE
  VISITING_CREATOR
}

enum CreatorSpecialty {
  PHOTOGRAPHY
  VIDEO
  WRITING
  AUDIO
  SOCIAL
  ILLUSTRATION
}

enum CreatorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CreatorStatus {
  ACTIVE
  PAUSED
}

model CreatorApplication {
  id              String                   @id @default(cuid())
  userId          String
  track           CreatorTrack
  displayName     String
  bio             String
  specialties     CreatorSpecialty[]       @default([])
  location        String?
  portfolioLinks  String[]                 @default([])
  pitch           String // why Taita, and a story or mission idea
  followerNote    String? // self-reported, admin-only, never shown publicly
  agreedToTermsAt DateTime // creator guidelines (incl. disclosure rules) accepted
  termsVersion    String
  status          CreatorApplicationStatus @default(PENDING)
  rejectionReason String? // shown to the applicant
  adminNotes      String? // internal
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, status])
}

model Creator {
  id          String             @id @default(cuid())
  userId      String             @unique
  slug        String             @unique
  displayName String
  track       CreatorTrack
  bio         String
  specialties CreatorSpecialty[] @default([])
  location    String?
  avatar      String?
  links       String[]           @default([])
  status      CreatorStatus      @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  claims MissionClaim[]
  notes  FieldNote[]

  @@index([status, track])
}

// ---------------------------------------------------------------------------
// Taita Field Crew — missions (Phase 2)
// ---------------------------------------------------------------------------
// A mission is a brief tied to a REAL destination (Phase 3's "verified on
// location" check needs a place that can be checked in at), listing the
// evidence a note should include. Disclosure is built in: a mission is
// independent, HOSTED (a partner provides e.g. a stay) or SPONSORED (a sponsor
// funds it), and the disclosure line creators paste into their posts is
// generated from that. Claiming a spot is atomic: spotsTaken moves with a
// conditional update, so two creators can't take the last spot.

enum MissionStatus {
  DRAFT
  OPEN
  CLOSED
}

enum MissionSupport {
  NONE
  HOSTED
  SPONSORED
}

enum MissionClaimStatus {
  ACTIVE
  WITHDRAWN
  SUBMITTED
  COMPLETED
}

model Mission {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  summary       String
  brief         String
  image         String?
  campaign      String? // e.g. "48 Hours in Taita"
  destinationId String
  track         CreatorTrack? // null = open to both tracks
  prompts       String[]       @default([]) // the evidence a note should include
  support       MissionSupport @default(NONE)
  supportNote   String? // what is provided (required when hosted or sponsored)
  hostName      String? // who hosts (HOSTED)
  sponsorId     String? // who sponsors (SPONSORED)
  accommodationId String? // a stay featured on the mission page and its notes
  experienceId    String? // an experience featured on the mission page and its notes
  rewardPoints  Int            @default(0) // Passport points on completion (awarded in Phase 3)
  maxCreators   Int? // null = unlimited
  spotsTaken    Int            @default(0)
  closesAt      DateTime?
  status        MissionStatus  @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  destination           Destination    @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  sponsor               Sponsor?       @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  featuredAccommodation Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: SetNull)
  featuredExperience    Experience?    @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  claims                MissionClaim[]
  notes                 FieldNote[]
  accommodationEnquiries AccommodationEnquiry[]
  experienceEnquiries    ExperienceEnquiry[]

  @@index([status, closesAt])
  @@index([destinationId])
  @@index([sponsorId])
  @@index([accommodationId])
  @@index([experienceId])
}

model MissionClaim {
  id          String             @id @default(cuid())
  missionId   String
  creatorId   String
  status      MissionClaimStatus @default(ACTIVE)
  claimedAt   DateTime           @default(now())
  withdrawnAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Restrict)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  note    FieldNote?

  @@unique([missionId, creatorId])
  @@index([creatorId, status])
}

// ---------------------------------------------------------------------------
// Taita Field Crew — Field Notes (Phase 3)
// ---------------------------------------------------------------------------
// A creator's structured report on a mission. It can only be filed after a
// VERIFIED check-in (QR or GPS) at the mission's destination made AFTER the
// mission was claimed; that check-in's time and method are copied onto the note
// (verifiedAt / verifiedMethod), which is what the public "Verified on location"
// badge shows. The answers line up with promptsSnapshot (the mission's prompts
// as they were when filed), so editing a mission later can't scramble old notes.
// disclosureText is the hosted/sponsored line as it stood at filing time.
// Approval publishes the note, completes the claim and awards the mission's
// points once (the PENDING -> APPROVED move is a conditional update).

enum FieldNoteStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  HIDDEN
}

model FieldNote {
  id                  String          @id @default(cuid())
  slug                String          @unique // "<mission-slug>--<creator-slug>"
  claimId             String          @unique
  missionId           String
  creatorId           String
  title               String
  promptsSnapshot     String[]        @default([])
  answers             String[]        @default([])
  body                String?
  photos              String[]        @default([])
  links               String[]        @default([])
  disclosureText      String?
  disclosureConfirmed Boolean         @default(false)
  verifiedAt          DateTime
  verifiedMethod      VisitMethod
  status              FieldNoteStatus @default(PENDING)
  reviewNote          String? // shown to the creator when changes are requested
  reviewedAt          DateTime?
  reviewedById        String?
  publishedAt         DateTime?
  pointsAwarded       Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  claim   MissionClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  mission Mission      @relation(fields: [missionId], references: [id], onDelete: Restrict)
  creator Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  accommodationEnquiries AccommodationEnquiry[]
  experienceEnquiries    ExperienceEnquiry[]

  @@index([status, createdAt])
  @@index([missionId, status])
  @@index([creatorId, status])
}

// ---------------------------------------------------------------------------
// Impact — page views (Taita Field Crew, Phase 4)
// ---------------------------------------------------------------------------
// One row per item per UTC day, holding a count — not one row per visit, so it
// stays small and holds no visitor identity. Views are counted from the browser
// (the note and mission pages are cached, so a server-side counter would miss
// most visits), once per browser session per item, excluding obvious bots and
// staff. They are an approximation and are labelled as one wherever shown.

enum ViewKind {
  NOTE
  MISSION
}

model ContentView {
  id       String   @id @default(cuid())
  kind     ViewKind
  targetId String
  day      DateTime @db.Date
  count    Int      @default(0)

  @@unique([kind, targetId, day])
  @@index([kind, targetId])
}

// ---------------------------------------------------------------------------
// Email outbox
// ---------------------------------------------------------------------------
// Every notification email is recorded here before it is sent, so a failure is visible and can be retried
// instead of vanishing. PENDING = not delivered yet (a retry is scheduled); SENT = delivered; FAILED = gave up
// after all retries (it can still be retried by hand while the message is kept).
//
// Privacy: the message body (which can contain an enquirer's details) is stored ONLY while the email still needs
// sending. It is cleared the moment the email is delivered, and cleared for anything unsent after 7 days; the
// rows themselves are deleted after 30 days. The admin screen never shows bodies.

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailLog {
  id            String      @id @default(cuid())
  to            String[]
  replyTo       String?
  subject       String
  body          String? // cleared once sent, and for unsent mail after 7 days
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  lastError     String? // includes the provider's own message, e.g. why a domain was refused
  nextAttemptAt DateTime? // when the next retry is due (also used as a short lease while one is in flight)
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
  unsubscribeUrl String? // this recipient's one-click unsubscribe link (newsletters and confirmation requests)
  campaignId     String? // the newsletter this email belongs to, so progress can be shown

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@index([campaignId])
}

// Visit Taita — data model (Phase 2: users/auth, content, Passport. Phase 3: Taita Cup sports portal)
// Run `npx prisma migrate dev` after setting DATABASE_URL, then `npm run db:seed`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / users
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CONTENT_MANAGER
  PARTNER
  SELLER
  EVENT_MANAGER
  CREATOR
  MEMBER
  VISITOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VISITOR)
  points       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  visits      Visit[]
  badges      UserBadge[]
  storiesWritten     Story[]       @relation("StoryAuthor")
  destinationsAdded  Destination[] @relation("DestinationCreatedBy")
  productsSold       Product[]     @relation("ProductsSold")
  ordersPlaced       Order[]       @relation("OrdersPlaced")
  applicationsReviewed PartnerApplication[] @relation("ApplicationsReviewed")

  accommodationsOwned    Accommodation[]        @relation("AccommodationOwner")
  experiencesOwned       Experience[]           @relation("ExperienceOwner")
  accommodationEnquiries AccommodationEnquiry[] @relation("AccommodationEnquiriesMade")
  experienceEnquiries    ExperienceEnquiry[]    @relation("ExperienceEnquiriesMade")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Content — Discover / destinations
// ---------------------------------------------------------------------------

enum DiscoverCategory {
  WILD
  CULTURE
  ADVENTURE
  FOOD
  SPORT
  PEOPLE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model Destination {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  category  DiscoverCategory
  region    String
  blurb     String
  image     String
  latitude  Float?
  longitude Float?
  status    ContentStatus    @default(DRAFT)
  featured  Boolean          @default(false)
  isDemo    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  createdById String?
  createdBy   User?   @relation("DestinationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  visits Visit[]

  @@index([category, status])
}

// ---------------------------------------------------------------------------
// Content — Stories (editorial)
// ---------------------------------------------------------------------------

enum StoryCategory {
  PEOPLE
  PLACES
  CULTURE
  SPORT
  ADVENTURE
}

model Story {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  category    StoryCategory
  excerpt     String
  body        String        @default("")
  readingTime String
  image       String
  status      ContentStatus @default(DRAFT)
  featured    Boolean       @default(false)
  isDemo      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  authorId String?
  author   User?   @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([category, status])
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

enum EventProgram {
  TAITA_CUP
  TAITA_WEEK
  TAITA_SOUND
}

model Event {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  program   EventProgram
  eventDate DateTime
  location  String
  blurb     String
  status    ContentStatus @default(DRAFT)
  isDemo    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([program, eventDate])
}

// ---------------------------------------------------------------------------
// Taita Passport — badges, points, visits
// ---------------------------------------------------------------------------

model Badge {
  id          String @id @default(cuid())
  key         String @unique // e.g. TAITA_WILD, TAITA_EXPLORER
  label       String
  description String
  icon        String @default("🧭")

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Visit {
  id            String   @id @default(cuid())
  userId        String
  destinationId String
  visitedAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}

// ---------------------------------------------------------------------------
// Newsletter
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Taita Cup — sports portal (teams, fixtures, standings)
// ---------------------------------------------------------------------------

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

model SportVenue {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  location  String
  capacity  Int?
  image     String
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fixtures SportFixture[]

  @@index([slug])
}

model SportTeam {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  town      String
  crest     String
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players      SportPlayer[]
  homeFixtures SportFixture[] @relation("HomeTeam")
  awayFixtures SportFixture[] @relation("AwayTeam")

  @@index([slug])
}

model SportPlayer {
  id        String   @id @default(cuid())
  name      String
  position  String
  number    Int?
  photo     String?
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamId String
  team   SportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model SportFixture {
  id        String        @id @default(cuid())
  kickoff   DateTime
  status    FixtureStatus @default(SCHEDULED)
  homeScore Int?
  awayScore Int?
  round     String?
  isDemo    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  homeTeamId String
  awayTeamId String
  venueId    String

  homeTeam SportTeam  @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam SportTeam  @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  venue    SportVenue @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([status, kickoff])
}

// ---------------------------------------------------------------------------
// Taita Made — marketplace (products, orders)
// ---------------------------------------------------------------------------

enum ProductCategory {
  CLOTHING
  ART
  CRAFTS
  FOOD
  HOME
  BOOKS
  PHOTOGRAPHY
  COLLECTIBLES
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum FulfillmentMethod {
  SHIPPING
  LOCAL_PICKUP
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  price       Int // whole KES, no decimals
  image       String
  category    ProductCategory
  sku         String          @unique
  inventory   Int             @default(0)
  offersShipping   Boolean    @default(true)
  offersPickup     Boolean    @default(true)
  status      ContentStatus   @default(DRAFT)
  featured    Boolean         @default(false)
  isDemo      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  sellerId String?
  seller   User?   @relation("ProductsSold", fields: [sellerId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@index([category, status])
}

enum PaymentMethod {
  NONE
  MPESA
  CARD
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

model Order {
  id          String            @id @default(cuid())
  orderNumber String            @unique
  status      OrderStatus       @default(PENDING)
  fulfillment FulfillmentMethod
  address     String?
  phone       String
  totalAmount Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  paymentMethod PaymentMethod @default(NONE)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentFailureReason String?
  paidAt        DateTime?

  mpesaCheckoutRequestId String?
  mpesaMerchantRequestId String?
  mpesaReceiptNumber     String?

  pesapalOrderTrackingId String?
  pesapalMerchantReference String?
  pesapalConfirmationCode  String?

  buyerId String
  buyer   User   @relation("OrdersPlaced", fields: [buyerId], references: [id], onDelete: Cascade)

  items OrderItem[]

  @@index([buyerId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id        String @id @default(cuid())
  quantity  Int
  unitPrice Int // snapshot of Product.price at order time

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Partner portal — applications
// ---------------------------------------------------------------------------

enum PartnerType {
  ACCOMMODATION
  EXPERIENCE
  FOOD
  TRANSPORT
  CREATOR
  SELLER
  EVENT
  SPONSOR
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PartnerApplication {
  id          String                    @id @default(cuid())
  businessName String
  contactName String
  email       String
  phone       String
  website     String?
  partnerType PartnerType
  message     String
  status      PartnerApplicationStatus  @default(PENDING)
  adminNotes  String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  reviewedAt  DateTime?

  reviewedById String?
  reviewedBy   User?   @relation("ApplicationsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Taita Week — festival programme
// ---------------------------------------------------------------------------

enum SessionCategory {
  MUSIC
  FOOD
  CULTURE
  SPORT
  FAMILY
  MARKET
  TALKS
}

enum TicketStatus {
  FREE
  TICKETED
  SOLD_OUT
}

model FestivalVenue {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  location  String
  image     String
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions FestivalSession[]

  @@index([slug])
}

model FestivalSession {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  category     SessionCategory
  description  String
  startsAt     DateTime
  endsAt       DateTime?
  ticketStatus TicketStatus    @default(FREE)
  price        Int?
  ticketUrl    String?
  status       ContentStatus   @default(DRAFT)
  featured     Boolean         @default(false)
  isDemo       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  venueId String
  venue   FestivalVenue @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([status, startsAt])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Experiences & Accommodation — enquiry-based bookings
// ---------------------------------------------------------------------------
// Deliberately NOT a real-time booking/payment engine (no availability
// calendar, no online payment capture) — matches the brief's Phase-3 scope:
// listings + an enquiry form, with an optional external booking link for
// partners who already run their own reservations system. Tied into the
// existing PartnerType.ACCOMMODATION / PartnerType.EXPERIENCE application
// types and the SELLER-style ownership pattern already used by Taita Made.

enum AccommodationType {
  HOTEL
  LODGE
  GUESTHOUSE
  HOMESTAY
  CAMPSITE
}

enum ExperienceCategory {
  WILDLIFE
  CULTURE
  ADVENTURE
  FOOD
  WELLNESS
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONFIRMED
  DECLINED
}

model Accommodation {
  id                 String            @id @default(cuid())
  slug               String            @unique
  name               String
  type               AccommodationType
  region             String
  description        String
  image              String
  priceFrom          Int? // whole KES, per night — optional ("contact for rates")
  amenities          String[]          @default([])
  contactPhone       String?
  contactEmail       String?
  externalBookingUrl String? // optional link to the partner's own booking engine
  status             ContentStatus     @default(DRAFT)
  featured           Boolean           @default(false)
  isDemo             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  ownerId String?
  owner   User?   @relation("AccommodationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  enquiries AccommodationEnquiry[]

  @@index([type, status])
}

model AccommodationEnquiry {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  name            String
  email           String
  phone           String
  checkIn         DateTime?
  checkOut        DateTime?
  guests          Int?
  message         String
  status          EnquiryStatus @default(NEW)
  createdAt       DateTime      @default(now())

  userId String?
  user   User?   @relation("AccommodationEnquiriesMade", fields: [userId], references: [id], onDelete: SetNull)

  @@index([accommodationId, status])
}

model Experience {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  category           ExperienceCategory
  region             String
  description        String
  image              String
  priceFrom          Int? // whole KES, per person — optional
  duration           String? // free text, e.g. "3 hours", "Full day"
  groupSizeMax       Int?
  contactPhone       String?
  contactEmail       String?
  externalBookingUrl String?
  status             ContentStatus      @default(DRAFT)
  featured           Boolean            @default(false)
  isDemo             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  ownerId String?
  owner   User?   @relation("ExperienceOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  enquiries ExperienceEnquiry[]

  @@index([category, status])
}

model ExperienceEnquiry {
  id            String        @id @default(cuid())
  experienceId  String
  experience    Experience    @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  name          String
  email         String
  phone         String
  preferredDate DateTime?
  partySize     Int?
  message       String
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())

  userId String?
  user   User?   @relation("ExperienceEnquiriesMade", fields: [userId], references: [id], onDelete: SetNull)

  @@index([experienceId, status])
}

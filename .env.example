# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/visit_taita"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Public base URL of this app (used to build M-Pesa/Stripe redirect and
# callback URLs). Must be a real, internet-reachable HTTPS URL for both
# M-Pesa and Stripe webhooks to work — localhost will not work. Use a
# tunnel (ngrok or similar) for local development.
NEXT_PUBLIC_APP_URL="https://your-app.example.com"

# M-Pesa (Safaricom Daraja API) — see https://developer.safaricom.co.ke
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://your-app.example.com/api/payments/mpesa/callback"

# Stripe (cards) — see https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

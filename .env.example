# PostgreSQL connection string (Prisma)
DATABASE_URL=""

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Public base URL of this app (used to build M-Pesa/Pesapal redirect and
# callback URLs). Must be a real, internet-reachable HTTPS URL for both
# M-Pesa and Pesapal webhooks to work — localhost will not work. Use a
# tunnel (ngrok or similar) for local development.
NEXT_PUBLIC_APP_URL="https://ungreased-quintuple-radiator.ngrok-free.dev"

# M-Pesa (Safaricom Daraja API) — see https://developer.safaricom.co.ke
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://ungreased-quintuple-radiator.ngrok-free.dev/api/payments/mpesa/callback"

# Pesapal (cards + M-Pesa/Airtel Money via Pesapal's hosted page) — see
# https://developer.pesapal.com. PESAPAL_IPN_ID comes from running
# `npm run pesapal:register-ipn` once — see README.
PESAPAL_ENV="sandbox"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_IPN_ID=""


# Email notifications (optional) — via Resend, https://resend.com
# Leave unset and notification emails are simply skipped; nothing breaks.
# NOTE: with the shared sender onboarding@resend.dev, Resend only delivers to
# the address your Resend account was created with. To email listing hosts or
# several team members, verify your own domain in Resend and use an address on
# it for EMAIL_FROM. Verify your setup with: npm run email:test -- you@example.com
RESEND_API_KEY= ""
EMAIL_FROM="Visit Taita <onboarding@resend.dev>"
# Comma-separated inbox(es) told about every sponsor lead and stay/experience enquiry
NOTIFY_EMAIL= ""


# --- Legal pages (/privacy, /terms, /contact). Nothing is guessed: a blank value shows as "[to be completed]". ---
# The registered legal name of the organisation that controls the data
SITE_LEGAL_NAME=
# Public contact details
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_ADDRESS=
# Where privacy requests go (defaults to CONTACT_EMAIL)
PRIVACY_EMAIL=
# Your registration number with Kenya's Office of the Data Protection Commissioner, once you have one
ODPC_REGISTRATION_NUMBER=
# Set this to the date (YYYY-MM-DD) a lawyer approved the Privacy Policy and Terms. Until it is set, both pages
# show a visible "Draft — pending legal review" notice.
LEGAL_REVIEWED_ON=

# --- Social links (leave blank to hide them; no dead links are shown) ---
# "visittaita", "@visittaita" or the profile URL
INSTAGRAM_HANDLE=
# Any common format: 0712 345 678, +254 712 345 678 or 254712345678
WHATSAPP_NUMBER=
# Optional: the message a visitor's WhatsApp chat starts with
WHATSAPP_MESSAGE=
# More accounts (each shows an icon in the footer only when set): "visittaita" or the page address
FACEBOOK_URL=
# "visittaita", "@visittaita" or https://www.tiktok.com/@visittaita
TIKTOK_HANDLE=
# "@visittaita" or the channel address, e.g. https://www.youtube.com/@visittaita
YOUTUBE_URL=
# "visittaita", "@visittaita" or https://x.com/visittaita
X_HANDLE=
# --- Public address (on Netlify, URL is provided for you; on Vercel, the production domain is) ---
# NEXT_PUBLIC_APP_URL=https://your-domain.example

# --- Picture uploads: S3-compatible storage (Cloudflare R2, AWS S3, Backblaze B2, DigitalOcean Spaces, MinIO) ---
# In DEVELOPMENT leave all of these blank: pictures are saved to public/uploads on your computer.
# In PRODUCTION they are REQUIRED (a serverless host's disk is read-only). Until set, picture fields fall back to a web-address box.
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com   AWS S3: https://s3.<region>.amazonaws.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Where the pictures are SERVED from — your bucket's public address or a custom domain, e.g. https://images.visittaita.co.ke
S3_PUBLIC_URL=
# Cloudflare R2: leave blank (it uses "auto"). AWS: the bucket's region, e.g. eu-west-1
S3_REGION=
# Leave blank. Set to false only for AWS S3's virtual-hosted style (bucket in the hostname)
S3_FORCE_PATH_STYLE=

# Scheduled jobs. The secret your scheduler sends to /api/cron/emails as "Authorization: Bearer <secret>".
# WITHOUT IT THE JOB REFUSES EVERY CALL: unpaid booking holds never expire and failed emails are never retried.
# Generate one with: openssl rand -hex 32
CRON_SECRET=""

# Two-step sign-in. 32 random bytes as base64 (generate with: openssl rand -base64 32). SETTING THIS SWITCHES THE FEATURE ON: every staff role must then set up two-step before using the admin area.
# Apply the database change (prisma/migrations/20261020090000_add_two_step) FIRST. KEEP A SAFE COPY somewhere other than the hosting settings: if it is lost, every secret and recovery code stops working. See docs/two-step.md.
TWO_FACTOR_KEY=""
# Optional. From this date (for example 2026-12-01) partners, sellers and event managers must use two-step too. Leave blank and they are never required.
TWO_FACTOR_MONEY_ROLES_FROM=""

# Leave these blank unless you know you need them.
# ALLOW_PRODUCTION_SEED=   "yes" lets the demo seed run on a production database (it never should)
# RESEND_API_URL=          overrides the email service address (used by automated tests)

# Homepage pictures (all optional). A path on this site (/home/hero.jpg, put the file in public/home/) or an https address.
# Empty = the licensed photograph the site already used for the hero, a drawn landscape behind it, and the same photo again at the end.
# HOME_HERO_IMAGE=       the big picture at the top of the homepage
# HOME_HERO_VIDEO=       an optional short silent film (mp4) that plays over the hero picture; it never plays for people who reduce motion or save data
# HOME_HERO_CREDIT=      who took the hero picture, shown quietly in its corner:  Name | Licence | https://link  (for example: Jane Doe | CC BY 4.0 | https://example.org/photo). Leave empty for a picture that needs no credit.
# HOME_STORY_URL=        where the "Watch the story" button goes (a film on YouTube or Vimeo, say). Empty = the button says "Read the stories" instead

# --- Taita Guide (the helper that offers a planned day, a maker, a surprise place or an AI guide). See docs/taita-guide.md ---
# Set to 1 to switch the whole guide off.
NEXT_PUBLIC_CONCIERGE_OFF=
# Switches on "Ask Taita", the AI guide that answers only from your own published pages. Leave empty to keep it off. Also set a spending limit with your AI provider.
ANTHROPIC_API_KEY=
# Optional: which model answers (default claude-haiku-5-5) and the most AI answers per day for the whole site (default 300).
CONCIERGE_MODEL=
CONCIERGE_DAILY_LIMIT=

# --- Running the tests (the website does not use this). The longest ONE test may take before it is stopped, in milliseconds. Default 180000 (3 minutes): raise it on a slow computer, e.g. 600000. ---
# TEST_TIMEOUT_MS=

# --- Set by your host, not by you: the version of the site that is running. It is shown beside each error in the admin Error log, so an error can be tied to the update that caused it. ---
# COMMIT_REF=
# VERCEL_GIT_COMMIT_SHA=

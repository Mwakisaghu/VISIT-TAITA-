# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/visit_taita"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Public base URL of this app (used to build M-Pesa/Pesapal redirect and
# callback URLs). Must be a real, internet-reachable HTTPS URL for both
# M-Pesa and Pesapal webhooks to work — localhost will not work. Use a
# tunnel (ngrok or similar) for local development.
NEXT_PUBLIC_APP_URL="https://your-app.example.com"

# M-Pesa (Safaricom Daraja API) — see https://developer.safaricom.co.ke
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://your-app.example.com/api/payments/mpesa/callback"

# Pesapal (cards + M-Pesa/Airtel Money via Pesapal's hosted page) — see
# https://developer.pesapal.com. PESAPAL_IPN_ID comes from running
# `npm run pesapal:register-ipn` once — see README.
PESAPAL_ENV="sandbox"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_IPN_ID=""
